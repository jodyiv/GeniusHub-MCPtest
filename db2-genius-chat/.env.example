# Copy to .env and edit.  `npm start` loads it automatically.
# Credentials are NOT stored here: each user signs in with their Genius Hub user id and
# password, and a fresh Genius Hub token is requested for every session.

PORT=3000
# Bind address. Keep 127.0.0.1 for a local demo; use 0.0.0.0 only behind HTTPS / a reverse proxy.
# HOST=127.0.0.1

# --- Db2 Genius Hub ---------------------------------------------------------
GH_HOST=db2server
GH_PORT=11100
GH_PROTOCOL=http
# Genius Hub MCP server endpoint (default port 8000)
MCP_URL=https://db2server:8000/mcp
# The MCP server uses a self-signed certificate unless a CA-signed one is installed.
# Set to false once it has a CA-signed certificate.
INSECURE_TLS=true

# --- LLM: any OpenAI-compatible /chat/completions endpoint with tool calling ---
# Ollama (IBM Granite):
LLM_BASE_URL=http://192.168.52.195:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=granite-optimized
# Slow CPU-only hosts may need longer than the 240 s default:
# LLM_TIMEOUT_MS=240000
#
# Other examples:
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...   LLM_MODEL=gpt-4o
#   vLLM   : LLM_BASE_URL=http://<host>:8000/v1       LLM_API_KEY=<key>    LLM_MODEL=<model>
